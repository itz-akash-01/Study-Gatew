# Copy to .env for local use (NEVER commit .env). On Vercel/Render, add these in the dashboard instead.
# Every value here stays on the server; none of it is sent to the browser.

APP_ENV=development                # use "production" on the live site
SITE_URL=http://localhost:5000     # live site: https://your-domain.com (no trailing slash)
SECRET_KEY=generate-a-new-random-64-character-string
# make one with:  python -c "import secrets; print(secrets.token_hex(32))"

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=paste-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key   # PRIVATE: full database access. Server only.
SUPABASE_BUCKET=study-pdfs

ADMIN_EMAILS=you@gmail.com         # comma-separated Google accounts that become admins at sign-in

# Optional
PUBLIC_PDF_READING=false           # true = anyone may read PDFs without signing in
MIN_UPLOAD_MB=1                    # smallest PDF accepted
MAX_UPLOAD_MB=20                   # largest PDF accepted. Vercel rejects requests over ~4.5 MB, so 20 needs Flask on Render/Railway/Fly
RATELIMIT_STORAGE_URI=memory://    # production: a Redis URL (e.g. free Upstash) so limits work across servers
TRUSTED_PROXY_COUNT=1              # number of proxies in front of Flask (Vercel/Render = 1; local = 0)
SECRET_KEY_FALLBACKS=              # old SECRET_KEY value(s) while rotating, comma-separated
